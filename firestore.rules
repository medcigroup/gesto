rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // PAGES PUBLIQUES D'HÔTELS - ACCÈS PUBLIC
    // ============================================
    match /hotels/{hotelId} {
      // LECTURE : Public (tout le monde peut lire)
      allow read: if true;

      // ÉCRITURE : seulement le propriétaire authentifié
      allow write: if request.auth != null && request.auth.uid == hotelId;
    }

    // ============================================
    // CHAMBRES - LECTURE PUBLIQUE POUR RÉSERVATION
    // ============================================
    match /users/{userId}/rooms/{roomId} {
      // LECTURE : Public (pour permettre aux clients de voir les chambres disponibles)
      allow read: if true;

      // ÉCRITURE : seulement le propriétaire
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================
    // RÉSERVATIONS ET BOOKINGS - LECTURE PUBLIQUE LIMITÉE
    // ============================================
    match /users/{userId}/reservations/{reservationId} {
      // LECTURE : Public (pour vérifier la disponibilité des chambres)
      allow read: if true;

      // ÉCRITURE : seulement le propriétaire ou le client authentifié
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (request.auth.uid == userId ||
                               request.auth.uid == resource.data.clientId);
    }

    match /users/{userId}/bookings/{bookingId} {
      // LECTURE : Public (pour vérifier la disponibilité des chambres)
      allow read: if true;

      // ÉCRITURE : seulement le propriétaire ou le client authentifié
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (request.auth.uid == userId ||
                               request.auth.uid == resource.data.clientId);
    }
    
    match /users/{userId}/bookingshours/{bookingId} {
      // LECTURE : Public (pour vérifier la disponibilité des chambres)
      allow read: if true;

      // ÉCRITURE : seulement le propriétaire ou le client authentifié
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (request.auth.uid == userId ||
                               request.auth.uid == resource.data.clientId);
    }

    // ============================================
    // COLLECTIONS PRINCIPALES (FALLBACK)
    // ============================================
    match /reservations/{reservationId} {
      // LECTURE : Public (pour vérifier la disponibilité)
      allow read: if true;

      // ÉCRITURE : seulement utilisateurs authentifiés
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (request.auth.uid == resource.data.userId ||
                               request.auth.uid == resource.data.clientId);
    }

    match /bookings/{bookingId} {
      // LECTURE : Public (pour vérifier la disponibilité)
      allow read: if true;

      // ÉCRITURE : seulement utilisateurs authentifiés
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (request.auth.uid == resource.data.userId ||
                               request.auth.uid == resource.data.clientId);
    }

    match /bookingshours/{bookingId} {
      // LECTURE : Public (pour vérifier la disponibilité)
      allow read: if true;

      // ÉCRITURE : seulement utilisateurs authentifiés
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
                              (request.auth.uid == resource.data.userId ||
                               request.auth.uid == resource.data.clientId);
    }

    match /rooms/{roomId} {
      // LECTURE : Public (pour permettre la recherche de chambres disponibles)
      allow read: if true;

      // ÉCRITURE : seulement le propriétaire authentifié
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ============================================
    // CLIENTS - GESTION DES PROFILS
    // ============================================
    match /clients/{clientId} {
      // LECTURE : seulement le client lui-même
      allow read: if request.auth != null && request.auth.uid == clientId;

      // ÉCRITURE : seulement le client lui-même
      allow write: if request.auth != null && request.auth.uid == clientId;
    }

    // ============================================
    // TOUTES LES AUTRES COLLECTIONS
    // Accès complet pour les utilisateurs authentifiés
    // ============================================
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
